# Backend runtime
HOST=0.0.0.0
PORT=3000

# Supabase (required)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional (not required by current frontend)
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Comma-separated browser origins allowed to call the API. Production defaults
# already include findmytube.co.za and the project GitHub Pages origin.
ALLOWED_ORIGINS=

# Optional Google Sheets integrations
STOCK_SHEETS_WEBHOOK_URL=
STOCK_ORDER_SHEETS_WEBHOOK_URL=

# Optional stock order emails via Resend (server-only; never put these in app-config.js)
# Recipient is fixed to 2milclinpathlab@gmail.com in lib/stock-order-email.js.
RESEND_API_KEY=
# Use a sender on a domain verified with Resend, e.g. Find My Tube <orders@findmytube.co.za>
STOCK_ORDER_EMAIL_FROM=
